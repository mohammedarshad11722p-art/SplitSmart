# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Where the Next.js app runs. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:3000

# ── Database (Neon) ──────────────────────────────────────
# Neon dashboard → Connection Details.
# Pooled URL (host contains "-pooler"), used by the running app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/splitsmart?sslmode=require
# Direct URL (no "-pooler"), used by `prisma migrate`:
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/splitsmart?sslmode=require

# ── Cloudinary (bill photos) ─────────────────────────────
# cloudinary.com → Dashboard → "Product Environment Credentials"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ── AI bill parsing ──────────────────────────────────────
# claude = real AI parsing. mock = returns a fixed sample bill (no key needed).
AI_PROVIDER=claude
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional. claude-sonnet-5-5 is cheaper per bill if you want to save credits.
AI_MODEL=claude-opus-5-5
