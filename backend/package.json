{
  "name": "splitsmart-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SplitSmart API + real-time server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "simulate": "tsx scripts/simulate-room.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@prisma/client": "6.16.2",
    "cloudinary": "2.11.0",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "8.7.3",
    "helmet": "8.0.0",
    "multer": "2.5.0",
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.16.2",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
