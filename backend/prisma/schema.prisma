// SplitSmart database schema
// Location: backend/prisma/schema.prisma
//
// Money rule: every amount is stored as an INTEGER number of paise
// (₹1 = 100 paise). Never store money as Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Neon pooled connection (used by the app)
  directUrl = env("DIRECT_DATABASE_URL") // Neon direct connection (used by migrations)
}

// ─────────────────────────────── Enums ───────────────────────────────

enum ParseStatus {
  PENDING // image uploaded, AI not finished yet
  PARSED  // AI returned valid JSON
  FAILED  // AI failed; host can still add items manually
  MANUAL  // host skipped AI and typed items in
}

enum RoomStatus {
  OPEN      // guests can join and claim items
  FINALIZED // claims locked, amounts calculated, payments in progress
  CLOSED    // everyone has paid, or host closed the room
}

enum PaymentStatus {
  PENDING
  PAID
}

// ─────────────────────────────── Models ──────────────────────────────

/// One uploaded restaurant bill. Created as soon as the host uploads a photo.
model Bill {
  id             String      @id @default(cuid())

  // Cloudinary image
  imageUrl       String?
  imagePublicId  String?     // needed to delete/transform the image later

  // Parsed header fields (paise)
  restaurantName String?
  subtotal       Int         @default(0)
  tax            Int         @default(0)
  serviceCharge  Int         @default(0)
  discount       Int         @default(0) // stored as a positive number, subtracted
  grandTotal     Int         @default(0)
  currency       String      @default("INR")

  // AI parsing + validation
  parseStatus    ParseStatus @default(PENDING)
  rawAiResponse  Json?       // exact AI output, for debugging bad parses
  hasMismatch    Boolean     @default(false) // sum(item.total) != subtotal
  mismatchAmount Int         @default(0)     // sum(item.total) - subtotal

  // No-login host auth: a random token is returned once to the host's
  // browser; we only store its SHA-256 hash.
  hostTokenHash  String

  items          Item[]
  room           Room?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/// One line on the bill. Editable by the host until the room is finalized.
model Item {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  name      String
  quantity  Int      @default(1)
  unitPrice Int      // paise
  total     Int      // paise; usually quantity * unitPrice, but we keep the
                     // printed value because bills sometimes disagree
  position  Int      @default(0) // display order, matches the printed bill

  claims    Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
}

/// A live split session for one bill. Joined via a 6-character code / QR.
model Room {
  id          String     @id @default(cuid())
  code        String     @unique @db.VarChar(6) // e.g. "K7P2QX"

  billId      String     @unique // one room per bill
  bill        Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)

  // Who receives the money (the host paid the restaurant)
  hostName    String
  hostUpiId   String     // e.g. "arshad@okaxis"

  status      RoomStatus @default(OPEN)
  finalizedAt DateTime?
  expiresAt   DateTime   // rooms are short-lived; lets us reuse codes later

  participants Participant[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// A person in a room (host included). No signup: just a name.
model Participant {
  id            String        @id @default(cuid())
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  name          String
  avatarColor   String        // hex, e.g. "#F97316", shown on claimed items
  avatarEmoji   String?       // optional fun touch
  isHost        Boolean       @default(false)

  // Random token stored in the guest's localStorage so a page refresh
  // or flaky mobile connection reconnects them as the same person.
  sessionToken  String        @unique

  // Filled in when the host finalizes, so the UPI link amount never
  // changes after it has been shared.
  amountDue     Int?          // paise

  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?

  claims        Claim[]

  joinedAt      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([roomId, name]) // two "Rahul"s in one room would be confusing
  @@index([roomId])
}

/// "This participant ate (part of) this item." Many-to-many join table.
/// If 3 participants claim one item, each pays 1/3 of it.
model Claim {
  id            String      @id @default(cuid())
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  @@unique([itemId, participantId]) // tapping twice can't double-claim
  @@index([participantId])
}
