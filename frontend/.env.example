# Copy to .env.local (Next.js reads it automatically). Never commit .env.local.

# Where the backend runs. NEXT_PUBLIC_ means this value is sent to the browser,
# so never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:4000

# In production (Vercel) set it to your Render URL, e.g.
#   NEXT_PUBLIC_API_URL=https://splitsmart-api.onrender.com
# It's baked in at build time: after changing it on Vercel, redeploy.
